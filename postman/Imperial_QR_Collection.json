        {
          "name": "PF-04 Crear Pedido Personalizado Válido (RN-03)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Responde 201 y crea la orden abierta\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.estado).to.eql(\"ABIERTA\");",
                  "    pm.expect(body.detalles[0].estado).to.eql(\"RECIBIDO\");",
                  "    pm.expect(body.detalles[0].precioUnitario).to.eql(27000);",
                  "    pm.environment.set(\"ordenId\", body.id);",
                  "    pm.environment.set(\"detalleId\", body.detalles[0].id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigoQr\": \"{{codigoQr}}\",\n  \"items\": [\n    {\n      \"platoId\": 1,\n      \"cantidad\": 1,\n      \"observaciones\": \"Poco picante\",\n      \"modificaciones\": [\n        { \"ingredienteId\": 1, \"accion\": \"QUITAR\" },\n        { \"ingredienteId\": 4, \"accion\": \"AGREGAR\" }\n      ]\n    }\n  ]\n}"
